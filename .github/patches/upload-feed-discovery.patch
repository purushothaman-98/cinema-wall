+    ]
+    profiles.sort(
+        key=lambda item: (
+            float(item.get("critic_weight", 0)),
+            float(item.get("engagement_weight", 0)),
+        ),
+        reverse=True,
+    )
+    return profiles[: int(CFG.get("upload_feed_max_channels", len(profiles)))]
